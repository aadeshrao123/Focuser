<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Release|x64"><Configuration>Release</Configuration><Platform>x64</Platform></ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{F3CD6BF4-93ED-4829-89AC-EDB777AADE20}</ProjectGuid>
    <RootNamespace>FocuserGuard</RootNamespace>
    <TargetName>FocuserGuard</TargetName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Driver</ConfigurationType>
    <DriverType>WDM</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <TargetVersion>Windows10</TargetVersion>
    <DriverTargetPlatform>Universal</DriverTargetPlatform>
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ItemDefinitionGroup>
    <ClCompile>
      <CompileAs>CompileAsC</CompileAs>
      <WarningLevel>Level4</WarningLevel>
      <TreatWarningAsError>true</TreatWarningAsError>
      <PreprocessorDefinitions>FOCUSER_EXPERIMENTAL_DRIVER=1;FOCUSER_GUARD_ALTITUDE=L&quot;$(FocuserGuardAltitude)&quot;;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>shared;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link><AdditionalDependencies>FltMgr.lib;%(AdditionalDependencies)</AdditionalDependencies><EnableIntegrityCheck>true</EnableIntegrityCheck></Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="kernel\driver.c" />
    <ClCompile Include="kernel\tamper.c" />
    <ClCompile Include="shared\guard_policy.c" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <Target Name="RequireExplicitExperimentalBuild" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(FocuserGuardExperimental)' != 'true'" Text="Uncertified kernel prototype: only an explicit experimental build is permitted." />
    <Error Condition="'$(FocuserGuardAltitude)' == ''" Text="Supply an allocated filter altitude; no production altitude is invented by this project." />
  </Target>
</Project>
