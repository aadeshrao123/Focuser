{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    // WXT's generated config leaves this unset — the React Vite plugin handles
    // JSX during the build, but `tsc --noEmit` needs to be told separately.
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
